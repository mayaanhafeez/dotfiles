{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#1a1b26",
    "bg_dark": "#16161e",
    "bg_float": "#16161e",
    "bg_highlight": "#222436",
    "bg_visual": "#414868",
    "black": "#15161e",
    "fg": "#ffffff",
    "fg_dark": "#a9b1d6",
