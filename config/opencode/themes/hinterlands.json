      "light": "grey1"
    },
    "syntaxFunction": {
      "dark": "white",
      "light": "white"
    },
    "syntaxVariable": {
      "dark": "fg_dark",
      "light": "fg_dark"
    },
    "syntaxString": {
      "dark": "grey5",
      "light": "grey5"
    },
    "syntaxNumber": {
      "dark": "grey6",
      "light": "grey6"
    },
    "syntaxType": {
      "dark": "grey4",
      "light": "grey4"
    },
    "syntaxOperator": {
      "dark": "grey2",
      "light": "grey2"
