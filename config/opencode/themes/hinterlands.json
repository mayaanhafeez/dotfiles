    "grey4": "#868686",
    "grey5": "#8b8b8b",
    "grey6": "#a0a0a0",
    "white": "#ffffff",
    "cursor": "#ffffff",
    "diff_add": "#2a2a2a",
    "diff_change": "#262626",
