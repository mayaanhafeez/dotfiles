{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#222222",
    "bg_dark": "#1a1a1a",
    "bg_float": "#2c2c2c",
    "bg_highlight": "#2c2c2c",
    "bg_visual": "#3a3a3a",
    "black": "#222222",
    "fg": "#ffffff",
    "fg_dark": "#b9b9b9",
    "fg_gutter": "#3a3a3a",
    "comment": "#525252",
    "grey1": "#686868",
    "grey2": "#747474",
