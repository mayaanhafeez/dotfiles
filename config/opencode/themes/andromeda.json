  "theme": {
    "primary": {
      "dark": "teal",
      "light": "teal"
    },
    "secondary": {
      "dark": "purple",
      "light": "purple"
    },
    "accent": {
      "dark": "red",
      "light": "red"
    },
    "error": {
      "dark": "error",
      "light": "error"
    },
    "warning": {
      "dark": "warning",
      "light": "warning"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "info",
      "light": "info"
    },
    "text": {
      "dark": "fg",
      "light": "fg"
    },
    "textMuted": {
      "dark": "fg_dark",
      "light": "fg_dark"
    },
    "background": {
      "dark": "bg",
      "light": "bg"
