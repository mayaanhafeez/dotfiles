{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#23262e",
    "bg_dark": "#1b1e24",
    "bg_float": "#2b2f38",
    "bg_highlight": "#2b2f38",
    "bg_visual": "#363b47",
    "black": "#000000",
    "fg": "#e5e5e5",
    "fg_dark": "#a9b1bd",
    "fg_gutter": "#3a3f4b",
    "comment": "#666666",
    "red": "#f92672",
    "orange": "#ee5d43",
    "yellow": "#ffe66d",
    "amber": "#f39c12",
    "green": "#96e072",
    "teal": "#00e8c6",
    "blue": "#7cb7ff",
    "purple": "#c74ded",
    "magenta": "#ff00aa",
    "white": "#e5e5e5",
    "cursor": "#f8f8f0",
    "diff_add": "#1e2f2b",
    "diff_change": "#232b38",
    "diff_delete": "#31212a",
    "git_add": "#96e072",
    "git_change": "#ffe66d",
    "git_delete": "#f92672",
    "border": "#2b2f38",
    "border_highlight": "#00e8c6",
    "error": "#f92672",
    "warning": "#f39c12",
    "info": "#7cb7ff",
    "hint": "#00e8c6"
