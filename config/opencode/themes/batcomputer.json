{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0b0f12", "panel": "#080b0d", "surface": "#16232c", "selection": "#1c4652",
    "border": "#293840", "fg": "#d7e1e5", "muted": "#8ea1aa", "gutter": "#40535d",
    "amber": "#ffb000", "amber_bright": "#ffdc7a", "blue": "#00b8d4", "cyan": "#72e4f5",
    "green": "#54d17a", "red": "#ff5c57", "purple": "#b68cff",
    "diff_add": "#10261c", "diff_change": "#172630", "diff_delete": "#301719"
  },
  "theme": {
    "primary": { "dark": "amber", "light": "amber" },
    "secondary": { "dark": "blue", "light": "blue" },
    "accent": { "dark": "cyan", "light": "cyan" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "muted", "light": "muted" },
    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "panel", "light": "panel" },
    "backgroundElement": { "dark": "surface", "light": "surface" },
    "border": { "dark": "border", "light": "border" },
    "borderActive": { "dark": "amber", "light": "amber" },
    "borderSubtle": { "dark": "gutter", "light": "gutter" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "diff_add", "light": "diff_add" },
    "diffRemovedBg": { "dark": "diff_delete", "light": "diff_delete" },
    "diffContextBg": { "dark": "surface", "light": "surface" },
    "diffLineNumber": { "dark": "gutter", "light": "gutter" },
    "markdownHeading": { "dark": "amber", "light": "amber" },
    "markdownLink": { "dark": "cyan", "light": "cyan" },
    "markdownCode": { "dark": "amber_bright", "light": "amber_bright" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "purple", "light": "purple" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "fg", "light": "fg" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "amber_bright", "light": "amber_bright" },
    "syntaxType": { "dark": "cyan", "light": "cyan" },
    "syntaxOperator": { "dark": "amber", "light": "amber" },
    "syntaxPunctuation": { "dark": "muted", "light": "muted" }
  }
}
