{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#000000",
    "bg_dark": "#090909",
    "bg_darker": "#070707",
    "bg_float": "#1a1a1a",
    "bg_highlight": "#1a1a1a",
    "bg_visual": "#2a2a2a",
    "fg": "#ffffff",
    "fg_light": "#ececec",
    "fg_dark": "#505050",
    "fg_gutter": "#2a2a2a",
    "comment": "#505050",
    "muted": "#7a7a7a",
    "accent": "#8d8d8d",
    "red": "#a4a4a4",
    "yellow": "#cecece",
    "orange": "#b9b9b9",
    "green": "#b6b6b6",
    "cyan": "#b0b0b0",
    "blue": "#8d8d8d",
    "magenta": "#9b9b9b",
    "brown": "#5c5c5c",
    "diff_add": "#0f0f0f",
    "diff_change": "#121212",
    "diff_delete": "#141414",
    "border": "#1a1a1a",
    "border_highlight": "#8d8d8d",
    "error": "#a4a4a4",
    "warning": "#b9b9b9",
    "info": "#b0b0b0",
    "hint": "#7a7a7a"
  },
  "theme": {
    "primary": {
      "dark": "accent",
      "light": "accent"
    },
    "secondary": {
      "dark": "magenta",
      "light": "magenta"
    },
    "accent": {
      "dark": "yellow",
      "light": "yellow"
    },
    "error": {
      "dark": "error",
      "light": "error"
    },
    "warning": {
      "dark": "warning",
      "light": "warning"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "info",
      "light": "info"
    },
    "text": {
      "dark": "fg",
      "light": "fg"
    },
    "textMuted": {
      "dark": "muted",
      "light": "muted"
    },
    "background": {
      "dark": "bg",
      "light": "bg"
    },
    "backgroundPanel": {
      "dark": "bg_dark",
      "light": "bg_dark"
    },
    "backgroundElement": {
      "dark": "bg_highlight",
      "light": "bg_highlight"
    },
    "border": {
      "dark": "border",
      "light": "border"
    },
    "borderActive": {
      "dark": "border_highlight",
      "light": "border_highlight"
    },
    "borderSubtle": {
      "dark": "comment",
      "light": "comment"
    },
    "diffAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffContext": {
      "dark": "muted",
      "light": "muted"
    },
    "diffHunkHeader": {
      "dark": "comment",
      "light": "comment"
    },
    "diffHighlightAdded": {
      "dark": "yellow",
      "light": "yellow"
    },
    "diffHighlightRemoved": {
      "dark": "brown",
      "light": "brown"
    },
    "diffAddedBg": {
      "dark": "diff_add",
      "light": "diff_add"
    },
    "diffRemovedBg": {
      "dark": "diff_delete",
      "light": "diff_delete"
    },
    "diffContextBg": {
      "dark": "bg_highlight",
      "light": "bg_highlight"
    },
    "diffLineNumber": {
      "dark": "fg_gutter",
      "light": "fg_gutter"
    },
    "diffAddedLineNumberBg": {
      "dark": "diff_add",
      "light": "diff_add"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diff_delete",
      "light": "diff_delete"
    },
    "markdownText": {
      "dark": "fg",
      "light": "fg"
    },
    "markdownHeading": {
      "dark": "fg",
      "light": "fg"
    },
    "markdownLink": {
      "dark": "accent",
      "light": "accent"
    },
    "markdownLinkText": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownCode": {
      "dark": "green",
      "light": "green"
    },
    "markdownBlockQuote": {
      "dark": "comment",
      "light": "comment"
    },
    "markdownEmph": {
      "dark": "fg_light",
      "light": "fg_light"
    },
    "markdownStrong": {
      "dark": "fg",
      "light": "fg"
    },
    "markdownHorizontalRule": {
      "dark": "fg_gutter",
      "light": "fg_gutter"
    },
    "markdownListItem": {
      "dark": "red",
      "light": "red"
    },
    "markdownListEnumeration": {
      "dark": "red",
      "light": "red"
    },
    "markdownImage": {
      "dark": "accent",
      "light": "accent"
    },
    "markdownImageText": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownCodeBlock": {
      "dark": "fg_light",
      "light": "fg_light"
    },
    "syntaxComment": {
      "dark": "comment",
      "light": "comment"
    },
    "syntaxKeyword": {
      "dark": "red",
      "light": "red"
    },
    "syntaxFunction": {
      "dark": "blue",
      "light": "blue"
    },
    "syntaxVariable": {
      "dark": "fg",
      "light": "fg"
    },
    "syntaxString": {
      "dark": "green",
      "light": "green"
    },
    "syntaxNumber": {
      "dark": "orange",
      "light": "orange"
    },
    "syntaxType": {
      "dark": "yellow",
      "light": "yellow"
    },
    "syntaxOperator": {
      "dark": "magenta",
      "light": "magenta"
    },
    "syntaxPunctuation": {
      "dark": "muted",
      "light": "muted"
    }
  }
}
