# Hinterlands — btop theme
# Written to match the Omarchy Hinterlands theme
# (github.com/OldJobobo/omarchy-hinterlands-theme), which ships no btop theme.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#222222"

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b9b9b9"

# Background color of selected item in processes box
theme[selected_bg]="#525252"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#525252"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#b9b9b9"

# Background color of the percentage meters
theme[meter_bg]="#2c2c2c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#868686"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#686868"
theme[mem_box]="#747474"
theme[net_box]="#868686"
theme[proc_box]="#8b8b8b"

# Box divider line and small boxes line color
theme[div_line]="#525252"

# Temperature graph color (cool -> hot)
theme[temp_start]="#525252"
theme[temp_mid]="#8b8b8b"
theme[temp_end]="#ffffff"

# CPU graph colors
theme[cpu_start]="#525252"
theme[cpu_mid]="#8b8b8b"
theme[cpu_end]="#ffffff"

# Mem/Disk free meter
theme[free_start]="#b9b9b9"
theme[free_mid]="#868686"
theme[free_end]="#525252"

# Mem/Disk cached meter
theme[cached_start]="#525252"
theme[cached_mid]="#868686"
theme[cached_end]="#b9b9b9"

# Mem/Disk available meter
theme[available_start]="#b9b9b9"
theme[available_mid]="#868686"
theme[available_end]="#525252"

# Mem/Disk used meter
theme[used_start]="#525252"
theme[used_mid]="#a0a0a0"
theme[used_end]="#ffffff"

# Download graph colors
theme[download_start]="#525252"
theme[download_mid]="#868686"
theme[download_end]="#b9b9b9"

# Upload graph colors
theme[upload_start]="#686868"
theme[upload_mid]="#a0a0a0"
theme[upload_end]="#ffffff"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#525252"
theme[process_mid]="#8b8b8b"
theme[process_end]="#ffffff"
